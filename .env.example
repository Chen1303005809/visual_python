# Internal API-to-runner credential. This is not used by Dify tool callers.
RUNNER_SHARED_TOKEN=replace-with-a-long-random-internal-token

# Address that Dify (or another caller) can reach on the host running this stack.
# Replace with the host IP/domain; localhost is only suitable for local calls.
API_PUBLIC_URL=http://localhost:8000

# Linux Docker Engine default. On Docker Desktop, set the absolute path to
# your Docker Desktop socket, for example /Users/you/.docker/run/docker.sock.
DOCKER_SOCKET_PATH=/var/run/docker.sock
API_PORT=8000
