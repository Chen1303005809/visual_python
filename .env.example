# Replace both values with long random secrets before starting the stack.
API_KEY=replace-with-a-long-random-api-key
RUNNER_SHARED_TOKEN=replace-with-a-different-long-random-token

# Set this to the Docker network shared by Dify's API/worker containers.
DIFY_DOCKER_NETWORK=dify_default

# Linux Docker Engine default. On Docker Desktop, set the absolute path to
# your Docker Desktop socket, for example /Users/you/.docker/run/docker.sock.
DOCKER_SOCKET_PATH=/var/run/docker.sock
API_PORT=8000
